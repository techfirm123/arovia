
{
  "name": "arovia",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @arovia/web dev",
    "build:web": "pnpm --filter @arovia/web build",
    "lint:web": "pnpm --filter @arovia/web lint",
    "typecheck:web": "pnpm --filter @arovia/web typecheck",
    "check:architecture:web": "pnpm --filter @arovia/web architecture",
    "test:web": "pnpm --filter @arovia/web test",
    "test:watch:web": "pnpm --filter @arovia/web test:watch"
  }
}
